{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Redis": {
    "Enabled": false,
    "InstanceName": "rpg-world"
  },
  "Simulation": {
    "TickIntervalMilliseconds": 100,
    "SystemFrequencyOverrides": {
      "Movement": "00:00:00.100",
      "Combat": "00:00:00.250",
      "NpcDecisions": "00:00:01",
      "Economy": "00:01:00",
      "Population": "00:10:00",
      "Diplomacy": "00:30:00",
      "GlobalEvents": "01:00:00"
    }
  },
  "AllowedHosts": "*"
}
